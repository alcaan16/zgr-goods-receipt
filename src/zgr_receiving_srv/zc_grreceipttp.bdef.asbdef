projection;
strict ( 2 );
use draft;

define behavior for ZC_GRReceiptTP alias Receipt
{
  use create;
  use update;
  use delete;

  use association _Item { create; with draft; }

  use action postReceipt;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Resume;
  use action Prepare;
}

define behavior for ZC_GRItemTP alias Item
{
  use update;
  use delete;

  use association _Receipt { with draft; }
  use association _Batch { create; with draft; }

  use action acceptDeviation;
}

define behavior for ZC_GRBatchTP alias Batch
{
  use update;
  use delete;

  use association _Item { with draft; }
  use association _Receipt { with draft; }

  use action blockBatch;
  use action releaseBatch;
}