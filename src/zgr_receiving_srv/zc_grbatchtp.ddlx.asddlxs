  BatchNumber;

  @UI: { lineItem:       [ { position: 20, label: 'Lote proveedor' } ],
         identification: [ { position: 20, label: 'Lote proveedor' } ] }
  SupplierBatch;

  @UI: { lineItem:       [ { position: 30, label: 'Fecha produccion' } ],
